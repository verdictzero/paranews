    "source": "https://d2rj6cu2ik1biv.cloudfront.net/193c804a-a673-47bd-b09b-11baf4822a17/7c05fcb0-7a79-4c64-9752-81b63d70add8/f3aab13c-255b-4340-9db5-146c38eecc30/thumbnails/b7f13d76-d8d7-4777-a366-556064b5b0d1.jpg?appId=9867779f-bbeb-44ef-a0d0-ca4e39424e99&platform=WEB&w=1200"
