---
import Base from "../../layouts/Base.astro";
import { MAP_MODES, sightings, timeline, type MapMode } from "../../lib/sightings";
import Timeline from "../../components/Timeline.astro";
import { href } from "../../lib/site";
import "leaflet/dist/leaflet.css";

export function getStaticPaths() {
  return MAP_MODES.map((mode) => ({ params: { mode: mode.slug }, props: { mode } }));
}

const { mode } = Astro.props as { mode: MapMode };
const points = sightings(mode.topic);
const days = timeline(mode.topic);
const totalReports = days.reduce((n, d) => n + d.count, 0);
const years = [...new Set(points.map((p) => p.date.slice(0, 4)))].sort();
const first = points[0]?.date.slice(0, 10);
const last = points[points.length - 1]?.date.slice(0, 10);
---

<Base title={mode.title} description={mode.blurb} current="map">
  <section class="section map-section">
    <div class="section-head">
      <h2>{mode.title}</h2>
      <span class="more">
        {MAP_MODES.filter((m) => m.slug !== mode.slug).map((m) => (
          <a href={href(`map/${m.slug}/`)}>{m.title} →</a>
        ))}
      </span>
    </div>
    <p class="section-blurb">{mode.blurb}</p>

    <div class="map-wrap">
      <div id="map" data-src={href(`map/${mode.slug}.json`)} data-base={href("")}></div>
      <noscript><p class="empty">The map needs JavaScript. The stories themselves are on the beat pages.</p></noscript>
    </div>

    <div class="map-controls">
      <label class="control">
        <input type="checkbox" id="heat" checked />
        Density
      </label>
      <label class="control">
        <input type="checkbox" id="pins" checked />
        Pins
      </label>
      <span class="control count"><b id="shown">{points.length}</b> of {points.length} placed shown</span>
      <button type="button" id="reset" class="read" hidden>Clear date range</button>
      <span class="control" id="range-label"></span>
    </div>

    <Timeline days={days} label={`Reports per day on this beat — ${totalReports} in total. Drag across the chart to filter the map.`} />

    <p class="map-note">
      {points.length} of the stories on this beat could be placed, between {first ?? "—"} and {last ?? "—"}
      {years.length > 1 ? ` across ${years.length} years` : ""}. A pin is where a report says something happened,
      not a verified location, and a story with no trustworthy place is left off entirely.
    </p>
  </section>
</Base>

<script>
  import L from "leaflet";
  import "leaflet.heat";

  interface Sighting {
    id: string; title: string; date: string; place: string; admin?: string;
    lat: number; lon: number; precision: string; from: string;
    publisher: string; tier: string; outlets: number; href: string;
  }

  const el = document.getElementById("map");
  if (el) {
    const base = el.dataset.base ?? "/";
    const map = L.map(el, { scrollWheelZoom: false, worldCopyJump: true }).setView([32, -40], 3);
    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);
    // A wheel over a page-width map should scroll the page; ctrl+wheel zooms.
    map.on("focus", () => map.scrollWheelZoom.enable());
    map.on("blur", () => map.scrollWheelZoom.disable());

    const pinLayer = L.layerGroup().addTo(map);
    let heatLayer: L.Layer | undefined;
    let all: Sighting[] = [];

    const esc = (s: string): string =>
      s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

    // Reports cluster on the same town, so identical coordinates would hide each
    // other. Spread repeats around a small ring instead of stacking them.
    function offset(p: Sighting, seenAt: Map<string, number>): [number, number] {
      const key = `${p.lat.toFixed(3)},${p.lon.toFixed(3)}`;
      const n = seenAt.get(key) ?? 0;
      seenAt.set(key, n + 1);
      if (n === 0) return [p.lat, p.lon];
      const angle = (n * 2.4) % (Math.PI * 2);
      const r = 0.05 + n * 0.012;
      return [p.lat + r * Math.sin(angle), p.lon + r * Math.cos(angle)];
    }

    function radius(precision: string): number {
      return precision === "landmark" || precision === "city" ? 6 : precision === "region" ? 8 : 10;
    }

    function render(points: Sighting[]): void {
      pinLayer.clearLayers();
      if (heatLayer) map.removeLayer(heatLayer);
      const seenAt = new Map<string, number>();
      const heat: [number, number, number][] = [];
      for (const p of points) {
        const [lat, lon] = offset(p, seenAt);
        heat.push([lat, lon, p.precision === "country" ? 0.35 : 1]);
        const marker = L.circleMarker([lat, lon], {
          radius: radius(p.precision),
          className: `pin pin-${p.precision} pin-from-${p.from}`,
          weight: 1.5,
          fillOpacity: 0.55,
        });
        const when = new Date(p.date).toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" });
        marker.bindPopup(
          `<a class="pop-title" href="${base}${p.href}">${esc(p.title)}</a>` +
            `<div class="pop-meta">${esc(p.place)}${p.admin ? ", " + esc(p.admin) : ""} · ${when}</div>` +
            `<div class="pop-meta">${esc(p.publisher)}${p.outlets > 1 ? ` and ${p.outlets - 1} more` : ""}` +
            `${p.from === "implied" ? " · location implied by the subject" : ""}</div>`,
        );
        pinLayer.addLayer(marker);
      }
      heatLayer = (L as unknown as { heatLayer: (pts: unknown[], opts: unknown) => L.Layer }).heatLayer(heat, {
        radius: 24,
        blur: 20,
        maxZoom: 6,
        minOpacity: 0.22,
        // Leaflet's default blue-to-lime reads as a weather map. This runs
        // through the paper's own accent and beat colours instead.
        gradient: { 0.2: "#2f6f5e", 0.45: "#8a6d24", 0.7: "#b0521a", 1: "#a02c1f" },
      });
      const shown = document.getElementById("shown");
      if (shown) shown.textContent = String(points.length);
      applyToggles();
    }

    function applyToggles(): void {
      const wantHeat = (document.getElementById("heat") as HTMLInputElement | null)?.checked ?? true;
      const wantPins = (document.getElementById("pins") as HTMLInputElement | null)?.checked ?? true;
      if (heatLayer) {
        if (wantHeat) heatLayer.addTo(map);
        else map.removeLayer(heatLayer);
      }
      if (wantPins) pinLayer.addTo(map);
      else map.removeLayer(pinLayer);
    }

    let range: { from: string; to: string } | undefined;

    function applyFilter(): void {
      const inRange = range ? all.filter((p) => p.date.slice(0, 10) >= range!.from && p.date.slice(0, 10) <= range!.to) : all;
      const label = document.getElementById("range-label");
      const reset = document.getElementById("reset");
      if (label) label.textContent = range ? `${range.from} to ${range.to}` : "";
      if (reset) reset.hidden = !range;
      render(inRange);
      if (range && inRange.length) {
        map.fitBounds(L.latLngBounds(inRange.map((p) => [p.lat, p.lon] as [number, number])).pad(0.2));
      }
    }

    for (const id of ["heat", "pins"]) document.getElementById(id)?.addEventListener("change", applyToggles);
    document.getElementById("reset")?.addEventListener("click", () => { range = undefined; applyFilter(); });

    // Brushing the chart is the date filter, and hovering it reads the counts.
    const figure = document.querySelector<HTMLElement>(".timeline");
    const svg = figure?.querySelector("svg");
    if (figure && svg) {
      const bars = [...svg.querySelectorAll<SVGPathElement>(".bars path")];
      const dates = bars.map((b) => b.dataset.date!);
      const tip = document.createElement("div");
      tip.className = "chart-tip";
      tip.hidden = true;
      figure.appendChild(tip);

      const nearest = (e: PointerEvent): string | undefined => {
        const box = svg.getBoundingClientRect();
        let best: { d: string; dist: number } | undefined;
        for (const b of bars) {
          const r = b.getBoundingClientRect();
          const dist = Math.abs((r.left + r.right) / 2 - e.clientX);
          if (!best || dist < best.dist) best = { d: b.dataset.date!, dist };
        }
        return box.width && best ? best.d : undefined;
      };

      let anchor: string | undefined;
      svg.addEventListener("pointermove", (e) => {
        const d = nearest(e);
        if (!d) return;
        const bar = bars.find((b) => b.dataset.date === d)!;
        for (const b of bars) b.classList.toggle("hot", b === bar);
        const when = new Date(`${d}T00:00:00Z`).toLocaleDateString(undefined, { month: "short", day: "numeric", timeZone: "UTC" });
        tip.textContent = `${when}: ${bar.dataset.count} reports, ${bar.dataset.placed} placed`;
        tip.hidden = false;
        const box = figure.getBoundingClientRect();
        tip.style.left = `${Math.min(Math.max(e.clientX - box.left, 8), box.width - 8)}px`;
        if (anchor) {
          range = { from: anchor < d ? anchor : d, to: anchor < d ? d : anchor };
          applyFilter();
        }
      });
      svg.addEventListener("pointerleave", () => {
        tip.hidden = true;
        for (const b of bars) b.classList.remove("hot");
      });
      svg.addEventListener("pointerdown", (e) => {
        anchor = nearest(e);
        if (anchor) {
          range = { from: anchor, to: anchor };
          svg.setPointerCapture(e.pointerId);
          applyFilter();
        }
      });
      const finish = (e: PointerEvent): void => {
        anchor = undefined;
        if (svg.hasPointerCapture(e.pointerId)) svg.releasePointerCapture(e.pointerId);
      };
      svg.addEventListener("pointerup", finish);
      svg.addEventListener("pointercancel", finish);
      // Keyboard and no-pointer users get the whole range; the map is the fallback.
      if (dates.length === 0) figure.remove();
    }

    fetch(el.dataset.src!)
      .then((r) => r.json() as Promise<Sighting[]>)
      .then((data) => {
        all = data;
        render(all);
        if (all.length) map.fitBounds(L.latLngBounds(all.map((p) => [p.lat, p.lon] as [number, number])).pad(0.15));
      })
      .catch(() => {
        el.insertAdjacentHTML("beforeend", '<p class="empty">The map data did not load.</p>');
      });
  }
</script>
