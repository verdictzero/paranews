---
import Base from "../layouts/Base.astro";
import TierBadge from "../components/TierBadge.astro";
import type { SourceHealth, SourceStatus } from "../../pipeline/types";
import { TOPIC_LABEL, formatDate, getSiteData, googleNewsHref } from "../lib/site";

const data = getSiteData();
const ORDER: Record<SourceStatus, number> = { quarantined: 0, failing: 1, ok: 2, disabled: 3 };
const rows = data.sources.sources
  .map((s) => {
    const h: SourceHealth = data.health.sources[s.id] ?? { status: s.enabled ? "ok" : "disabled", consecutive_failures: 0 };
    const status: SourceStatus = s.enabled ? h.status : "disabled";
    return { s, h, status };
  })
  .sort((a, b) => ORDER[a.status] - ORDER[b.status] || a.s.name.localeCompare(b.s.name));
const counts = rows.reduce(
  (acc, r) => {
    acc[r.status]++;
    return acc;
  },
  { ok: 0, failing: 0, quarantined: 0, disabled: 0 } as Record<SourceStatus, number>,
);
---

<Base title="Sources" description="Every feed Paranews polls, its tier, and whether it is currently answering." current="sources">
  <section class="section">
    <div class="section-head">
      <h2>Sources</h2>
      <span class="more">{counts.ok} live · {counts.failing} failing · {counts.quarantined} quarantined · {counts.disabled} retired</span>
    </div>
    <p class="section-blurb">Google News searches carry the breadth; direct feeds carry real links, snippets and personality. Three consecutive failures quarantine a feed; a daily probe brings it back.</p>
    <div class="table-wrap">
      <table class="sources">
        <thead>
          <tr>
            <th>Source</th>
            <th>Kind</th>
            <th>Beat</th>
            <th>Tier</th>
            <th>Status</th>
            <th>Last success</th>
            <th>Items</th>
            <th>Note</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map(({ s, h, status }) => (
              <tr>
                <td>
                  <a href={s.kind === "google-news" ? googleNewsHref(s) : s.url}>{s.name}</a>
                  {s.kind === "google-news" && <div class="section-blurb" style="font-size:12px;margin:2px 0 0">{s.query}</div>}
                </td>
                <td>{s.kind === "google-news" ? `Google News (${s.edition ?? "US"})` : "Feed"}</td>
                <td>{s.topics === "auto" ? `auto${s.default_topic ? ` → ${TOPIC_LABEL[s.default_topic]}` : ""}` : s.topics.map((t) => TOPIC_LABEL[t]).join(", ")}</td>
                <td>{s.kind === "google-news" ? <span class="section-blurb">per publisher</span> : <TierBadge tier={s.tier!} />}</td>
                <td>
                  <span class:list={["status", status]}>{status}</span>
                  {status !== "ok" && status !== "disabled" && h.last_error && <div class="section-blurb" style="font-size:12px;margin:2px 0 0">{h.last_error}</div>}
                </td>
                <td>{h.last_ok_at ? <time datetime={h.last_ok_at}>{formatDate(h.last_ok_at)}</time> : "—"}</td>
                <td>{h.last_item_count ?? "—"}</td>
                <td>{s.note}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</Base>
