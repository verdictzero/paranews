---
import Base from "../../layouts/Base.astro";
import TierBadge from "../../components/TierBadge.astro";
import type { Cluster } from "../../../pipeline/types";
import { TOPIC_LABEL, distinctPublishers, formatDate, getSiteData, hostOf, href, primaryOf, readerFor, readerImagePath, snippetOf, topicPath, writeUpsOf } from "../../lib/site";

export function getStaticPaths() {
  return getSiteData().storyPages.map((cluster) => ({ params: { id: cluster.id }, props: { cluster } }));
}

interface Props {
  cluster: Cluster;
}
const { cluster } = Astro.props;
const data = getSiteData();
const groups = writeUpsOf(cluster, data);
const primary = primaryOf(cluster, data);
const outlets = cluster.publishers.length;
const reader = readerFor(cluster, data);
const snippet = snippetOf(cluster, data);
// A wire story runs on dozens of affiliates; naming six of them makes the point.
const SYNDICATION_SHOWN = 6;
---

<Base title={cluster.title} description={snippet ?? `${outlets} ${outlets === 1 ? "outlet" : "outlets"} on: ${cluster.title}`}>
  <article class="story-page">
    <div class="kicker">
      <TierBadge tier={cluster.tier} />
      {cluster.topics.map((t) => <a class:list={["tag", t]} href={href(topicPath(t))}>{TOPIC_LABEL[t]}</a>)}
      <span>First seen {formatDate(cluster.first_published)}</span>
      {cluster.corroboration >= 2 && <span class="corroborated">{cluster.corroboration} independent press write-ups</span>}
      {cluster.flags.map((f) => <span class="flag">demoted: {f}</span>)}
    </div>
    <h1>{cluster.title}</h1>
    <div class="actions">
      <a class="primary" href={primary.url}>Read at {primary.publisher} →</a>
      {reader && (
        <button type="button" class="primary read" data-reader={reader.item.id} data-reader-url={reader.item.url}>
          Read here
        </button>
      )}
    </div>
    {
      reader?.article.image && (
        <img
          class="hero"
          src={href(readerImagePath(reader.item.id))}
          width={reader.article.image.width}
          height={reader.article.image.height}
          alt=""
          decoding="async"
          data-reader={reader.item.id}
          data-reader-url={reader.item.url}
        />
      )
    }
    {snippet && <p class="snippet">{snippet}</p>}
    <h2>Coverage · {groups.length} {groups.length === 1 ? "write-up" : "write-ups"} · {outlets} {outlets === 1 ? "outlet" : "outlets"}</h2>
    <ul class="coverage">
      {
        groups.map((group) => {
          const m = group[0];
          // Everyone else running this same write-up: syndication, not a
          // second account of the event.
          const carried = distinctPublishers(group).slice(1);
          const syndicated = carried.slice(0, SYNDICATION_SHOWN);
          const alsoMore = carried.length - syndicated.length;
          return (
            <li>
              <span class="who">
                <a href={m.url}>{m.publisher}</a> <TierBadge tier={m.tier} />
                {data.articles.has(m.id) && (
                  <button type="button" class="read" data-reader={m.id} data-reader-url={m.url}>
                    Read here
                  </button>
                )}
              </span>
              <span class="when">
                <time datetime={m.published_at}>{formatDate(m.published_at)}</time> · {hostOf(m)}
              </span>
              {m.title !== cluster.title && <span class="what">{m.title}</span>}
              {syndicated.length > 0 && (
                <span class="syndicated">
                  Also carried by {syndicated.join(", ")}
                  {alsoMore > 0 && ` and ${alsoMore} more`}
                </span>
              )}
            </li>
          );
        })
      }
    </ul>
  </article>
</Base>
